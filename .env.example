# Carpeta donde se guardan los proyectos (por defecto ./data)
DATA_DIR=./data
# Distancia de siembra por defecto en metros (diámetro del hexágono de cada spot)
DISTANCIA_SIEMBRA=9
# Tamaño máximo de archivo subido, en MB
MAX_UPLOAD_MB=200
# Orígenes permitidos si el frontend se sirve desde otro dominio (separados por coma). Vacío = mismo origen.
CORS_ORIGINS=
